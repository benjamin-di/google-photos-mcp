# syntax=docker/dockerfile:1.7
# Runtime dependencies for photos-mcp on a digest-pinned Python base. Kept apart from the
# source so code-only releases reuse this layer: release.yml keys the image on this file and
# requirements-runtime.lock. Rebuild it when dependencies change (make lock rewrites
# requirements-runtime.lock) or when these pins are upgraded (deliberately, never a moving tag).
FROM ghcr.io/astral-sh/uv:0.9.26@sha256:9a23023be68b2ed09750ae636228e903a54a05ea56ed03a934d00fe9fbeded4b AS uv

FROM python:3.12.14-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

COPY runtime-installer.py /tmp/runtime-installer.py
RUN python /tmp/runtime-installer.py && rm /tmp/runtime-installer.py

COPY --from=uv /uv /usr/local/bin/uv

# The committed hash lock makes rebuilds independent of the package index's state.
COPY requirements-runtime.lock /tmp/requirements-runtime.lock
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --compile-bytecode --require-hashes -r /tmp/requirements-runtime.lock \
    && rm -f /tmp/requirements-runtime.lock \
    && python -c 'import curl_cffi, PIL, fastmcp, tzdata; assert fastmcp.__version__ == "4.0.10"'

ARG DEPS_REF=unknown
LABEL org.opencontainers.image.title="photos-mcp-deps" \
      org.opencontainers.image.revision="${DEPS_REF}"

CMD ["true"]
